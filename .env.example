APP_NAME="Lead Finder Pro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=sqlite
DB_DATABASE=/path/to/database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file

# Stripe Configuration
STRIPE_KEY=pk_test_xxxxx
STRIPE_SECRET=*** Price IDs
STRIPE_PRICE_PRO=price_xxxxx_pro
STRIPE_PRICE_BUSINESS=price_xxxxx_business
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Feature Flags (Modules)
FEATURE_EXPORT_ENHANCED=true
FEATURE_LEAD_ENRICHMENT=true
FEATURE_ANALYTICS=true

# Optional: Rate limiting
RATE_LIMIT_PER_MINUTE=30

# Feature Modules (true/false)
FEATURE_STRIPE=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_PASSWORD_RESET=false
FEATURE_API=true
FEATURE_NOTIFICATIONS=true

# Export Scheduler
FEATURE_EXPORT_SCHEDULER=true

# Billing Module
FEATURE_BILLING=false
